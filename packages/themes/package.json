{
  "name": "@datav-kit/themes",
  "type": "module",
  "version": "0.0.4",
  "description": "Optional CSS variable themes for datav-kit.",
  "author": "hackycy <hackycy@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/hackycy/datav-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hackycy/datav-kit.git"
  },
  "bugs": "https://github.com/hackycy/datav-kit/issues",
  "sideEffects": [
    "*.css",
    "./dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./cyber-blue.css": "./dist/cyber-blue.css",
    "./neon-magenta.css": "./dist/neon-magenta.css",
    "./matrix-green.css": "./dist/matrix-green.css",
    "./solar-gold.css": "./dist/solar-gold.css",
    "./ice-white.css": "./dist/ice-white.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
}
