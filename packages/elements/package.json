{
  "name": "@datav-kit/elements",
  "type": "module",
  "version": "0.0.0",
  "description": "Web Components entrypoints for datav-kit elements.",
  "author": "hackycy <hackycy@outlook.com>",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./register": {
      "types": "./dist/register.d.mts",
      "import": "./dist/register.mjs"
    },
    "./fit-screen": {
      "types": "./dist/fit-screen/index.d.mts",
      "import": "./dist/fit-screen/index.mjs"
    },
    "./border-box-1": {
      "types": "./dist/border-box-1/index.d.mts",
      "import": "./dist/border-box-1/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint src test",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@datav-kit/core": "workspace:*",
    "lit": "catalog:runtime"
  }
}
